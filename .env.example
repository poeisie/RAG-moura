# Caminhos
DATA_DIR=data
INDEX_DIR=index_store
DB_PATH=historico.db

# Embeddings (modelo local via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
DEFAULT_K=4

# OpenRouter (obtenha uma chave gratuita em https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
